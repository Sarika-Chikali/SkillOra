rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /vaultFiles/{fileId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }

    // Shared, non-personal design fingerprints (colors/layout/font of a
    // certificate template) used to recognize known-genuine issuer patterns.
    // Never contains names, dates, or any per-user data.
    match /issuerTemplates/{issuerId} {
      allow read, write: if request.auth != null;
    }

    match /resumeData/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /tailored/{tailoredId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /portfolios/{uid} {
      // A published portfolio is readable by anyone (that's the point of
      // publishing it); everything else is owner-only.
      allow read: if (request.auth != null && request.auth.uid == uid) || resource.data.published == true;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /projects/{projectId} {
        allow read: if (request.auth != null && request.auth.uid == uid) ||
          get(/databases/$(database)/documents/portfolios/$(uid)).data.published == true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Public slug -> uid lookup so a portfolio can be found by its URL
    // without exposing anything else. No personal data lives here.
    match /portfolioSlugs/{slug} {
      allow read: if true;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /personalityProfiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /quizzes/{quizId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /dailyTasks/{date} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
