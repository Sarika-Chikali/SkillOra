# SkillOra Environment Variables Example Configuration
# Copy this file to .env.local and fill in the values from your provider developer dashboards.

# ==============================================================================
# VERCEL OAUTH CONFIGURATION
# Register an Integration/OAuth Application at: https://vercel.com/dashboard/integrations
# Set Redirect URI to: http://localhost:3000/api/auth/vercel/callback
# ==============================================================================
VERCEL_CLIENT_ID="oat_your_vercel_client_id_here"
VERCEL_CLIENT_SECRET="your_vercel_client_secret_here"
VERCEL_REDIRECT_URI="http://localhost:3000/api/auth/vercel/callback"
VERCEL_PROJECT_ID=""
# Optional server token for automated testing
VERCEL_API_TOKEN=""

# ==============================================================================
# NETLIFY OAUTH CONFIGURATION
# Register an OAuth Application at: https://app.netlify.com/user/applications#oauth-apps
# Set Redirect URI to: http://localhost:3000/api/auth/netlify/callback
# ==============================================================================
NETLIFY_CLIENT_ID=""
NETLIFY_CLIENT_SECRET=""
NETLIFY_REDIRECT_URI="http://localhost:3000/api/auth/netlify/callback"
NETLIFY_SITE_ID=""
NETLIFY_AUTH_TOKEN=""

# ==============================================================================
# FIREBASE & RENDER CONFIGURATION (OPTIONAL)
# ==============================================================================
FIREBASE_TOKEN=""
FIREBASE_PROJECT_ID=""
RENDER_API_KEY=""
RENDER_SERVICE_ID=""
